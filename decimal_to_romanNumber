#include <stdio.h>

int main() {
    int number;

    printf("Enter a number (1-3999): ");
    scanf("%d", &number);

    if (number < 1 || number > 3999) {
        printf("Invalid input! Please enter a number between 1 and 3999.\n");
        return 0;
    }

    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40,
                    10, 9, 5, 4, 1};

    char *symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L",
                       "XL", "X", "IX", "V", "IV", "I"};

    printf("Roman Numeral: ");

    for (int i = 0; i < 13; i++) {
        while (number >= values[i]) {
            printf("%s", symbols[i]);
            number -= values[i];
        }
    }

    printf("\n");

    return 0;
}
